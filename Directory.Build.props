<Project>
	<PropertyGroup>
		<TargetFramework>net11.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
		<CodeAnalysisRuleSet>$(MSBuildThisFileDirectory)Rules.ruleset</CodeAnalysisRuleSet>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AnalysisMode>AllEnabledByDefault</AnalysisMode>
		<AnalysisLevel>latest</AnalysisLevel>
		<NoWarn>NU1902,NU1903,NU1604</NoWarn>
		<ImplicitUsings>enable</ImplicitUsings>
		<Features>runtime-async=on</Features>
		<VersionPrefix>1.0.0</VersionPrefix>
	</PropertyGroup>
	<!-- SDK 11 does not mark ProjectReference satellite outputs as resources for NativeAOT.
	     Preserve their resource identity so ILC embeds them, just like the executable's own satellites. -->
	<Target Name="MarkProjectSatelliteResourcesForAot" BeforeTargets="_ComputeIlcCompileInputs" Condition="'$(PublishAot)' == 'true'">
		<ItemGroup>
			<ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.dll' and $([System.String]::Copy('%(ResolvedFileToPublish.Filename)').EndsWith('.resources'))">
				<AssetType>resources</AssetType>
			</ResolvedFileToPublish>
		</ItemGroup>
	</Target>
</Project>