@* One value per language, each a full-width row labelled "{Label} ({language})" with its remove button beside it,
   followed by the button adding a language: it asks for the language code in a dialog, then shows the new value row
   focused. The field has no heading of its own, so it lines up with plain fields in neighbouring grid columns. *@
@inject FeedSession Session
@inject IDialogService DialogService

<MudStack Spacing="2">
	@foreach (var language in (Value?.Keys.ToArray() ?? []))
	{
		<MudStack Row="true" AlignItems="AlignItems.Start" Spacing="1" @key="language">
			<div class="flex-grow-1" style="min-width: 0">
				@if (IsPath)
				{
					<S3PathField Value="@(Value![language])" ValueChanged="@(text => SetTextAsync(language, text))" Label="@($"{Label} ({language})")" Required="true"
								 AutoFocus="@(language == _addedLanguage)" />
				}
				else
				{
					<MudTextField T="string" Value="@(Value![language])" ValueChanged="@(text => SetTextAsync(language, text))" Label="@($"{Label} ({language})")" Required="true"
								  AutoFocus="@(language == _addedLanguage)" Sizing="InputSizing.Auto" MaxLines="6" Variant="Variant.Outlined" Margin="Margin.Dense" />
				}
			</div>
			<MudTooltip Text="@($"Удалить язык {language}")">
				<MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Class="mt-1" aria-label="@($"Удалить язык {language}")"
							   OnClick="@(() => RemoveAsync(language))" />
			</MudTooltip>
		</MudStack>
	}
	<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
		<MudButton StartIcon="@Icons.Material.Filled.Add" Class="flex-shrink-0" OnClick="AddAsync">@($"{Label}: добавить язык")</MudButton>
		<MudText Typo="Typo.caption" Class="mud-text-secondary">@HelperText</MudText>
	</MudStack>
</MudStack>

@code {
	[Parameter] public IReadOnlyDictionary<string, string>? Value { get; set; }
	[Parameter] public EventCallback<IReadOnlyDictionary<string, string>?> ValueChanged { get; set; }
	[Parameter, EditorRequired] public required string Label { get; set; }
	[Parameter] public bool IsPath { get; set; }
	[Parameter] public bool Optional { get; set; }
	[CascadingParameter(Name = FeedChangedCascade.Name)] public EventCallback FeedChanged { get; set; }
	private string? _addedLanguage;

	private string HelperText =>
		$"{(Optional ? "Необязательное поле. Если задано, нужен" : "Обязателен")} язык по умолчанию: {Session.Feed?.DefaultLanguage}";

	// Required fields retain one mutable dictionary; optional maps may be replaced to enable/disable the field.
	private Dictionary<string, string> EditableValues() =>
		Value as Dictionary<string, string> ?? (Value is null ? [] : new Dictionary<string, string>(Value));
	private async Task AddAsync()
	{
		var dialog = await DialogService.ShowAsync<AddLanguageDialog>(
			$"{Label}: новый язык",
			new DialogParameters<AddLanguageDialog>
			{
				{ x => x.ExistingLanguages, Value?.Keys.ToArray() ?? [] },
				{ x => x.DefaultLanguage, Session.Feed?.DefaultLanguage },
			},
			new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
		if (await dialog.Result is not { Canceled: false, Data: string language })
		{
			return;
		}

		var values = EditableValues();
		values.Add(language, string.Empty);
		Value = values;
		_addedLanguage = language;
		await ValueChanged.InvokeAsync(values);
		await FeedChanged.InvokeAsync();
	}

	private async Task SetTextAsync(string language, string? text)
	{
		var values = EditableValues();
		values[language] = text ?? string.Empty;
		Value = values;
		await ValueChanged.InvokeAsync(Value);
		await FeedChanged.InvokeAsync();
	}

	private async Task RemoveAsync(string language)
	{
		var values = EditableValues();
		values.Remove(language);
		Value = values;
		if (Optional && Value.Count == 0) Value = null;
		await ValueChanged.InvokeAsync(Value);
		await FeedChanged.InvokeAsync();
	}
}
