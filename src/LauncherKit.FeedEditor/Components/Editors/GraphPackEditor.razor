<ModEditor Mod="Pack">
	<MudItem xs="12" md="6">
		<LocalizedField Value="Pack.Recommendation" Label="Рекомендация" />
	</MudItem>
	<MudItem xs="12" md="6">
		<MudSwitch @bind-Value="Pack.IsDefault" Label="Выбран по умолчанию при установке сборки" Color="Color.Primary" />
	</MudItem>
	<MudItem xs="12" md="6">
		<MudSwitch @bind-Value="Pack.IsDiscontinued" Label="Снят с поддержки: скрыт для версий сборки, которые не поддерживает ни одна его версия"
				   Color="Color.Primary" />
	</MudItem>
	<MudItem xs="12">
		<MudText Typo="Typo.caption" Class="mud-text-secondary">
			Графпак устанавливается как опциональный мод: основной архив, затем шаги установки. Обновление переустанавливает графпак: откатывает шаги установленной версии, удаляет мод и устанавливает новую версию.
		</MudText>
	</MudItem>
</ModEditor>

@code {
	[Parameter, EditorRequired]
	public required GraphPackModel Pack { get; set; }
}
