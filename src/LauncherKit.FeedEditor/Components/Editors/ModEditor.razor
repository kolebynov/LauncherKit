@inject FeedSession Session

<MudStack Spacing="3">
	<MudGrid Spacing="2">
		<MudItem xs="12" md="6">
			<MudTextField @bind-Value="Mod.Name" Label="Имя" Required="true" Validation="@FeedRules.Required"
						  HelperText="Имя мода в Mod Organizer; идентифицирует мод" Variant="Variant.Outlined" Margin="Margin.Dense" />
		</MudItem>
		<MudItem xs="12" md="6">
			<LocalizedField @bind-Value="Mod.DisplayName" Label="Отображаемое имя" Optional="true" />
		</MudItem>
		<MudItem xs="12" md="6">
			<S3PathField @bind-Value="Mod.LogoPath" Label="Путь к логотипу" Required="true" />
		</MudItem>
		<MudItem xs="12" md="6">
			<LocalizedField Value="Mod.DescriptionPath" Label="Путь к описанию" IsPath="true" />
		</MudItem>
		<MudItem xs="12" md="6">
			<MudSelect T="string" @bind-Value="Mod.CategoryId" Label="Категория" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense">
				@foreach (var category in Session.Feed!.ModCategories)
				{
					<MudSelectItem Value="@category.Id">@category.Id</MudSelectItem>
				}
			</MudSelect>
		</MudItem>
		<MudItem xs="12" md="6">
			<LocalizedField @bind-Value="Mod.OptionDescription" Label="Описание варианта при установке сборки" Optional="true" />
		</MudItem>
		<MudItem xs="12" md="6">
			<MudSwitch @bind-Value="Mod.IsDiscontinued" Label="Снят с поддержки" Color="Color.Primary" />
			<MudText Typo="Typo.caption">Скрывается для версий сборки, которые не поддерживает ни одна его версия, вместо пометки «не обновлен»</MudText>
		</MudItem>
		<MudItem xs="12" md="6">
			<MudSwitch @bind-Value="Mod.RequiresNewGame" Label="Требует новой игры" Color="Color.Primary" />
			<MudText Typo="Typo.caption">Лаунчер предупреждает об этом при первой установке и при удалении</MudText>
		</MudItem>
	</MudGrid>

	<MudText Typo="Typo.subtitle1">Версии</MudText>
	<ListEditor TItem="ModItemModel" Items="Mod.Items" Factories="ItemFactories"
				Title="@(item => $"{item.Version} — сборка {item.SupportedModpackVersion}{(item.SupportsUninstall ? " (можно удалить)" : string.Empty)}")">
		<ItemContent Context="item">
			<ModItemEditor Item="item" />
		</ItemContent>
	</ListEditor>
</MudStack>

@code {
	private static readonly IReadOnlyList<ListItemFactory<ModItemModel>> ItemFactories = [new("версию", () => new ModItemModel())];

	[Parameter, EditorRequired]
	public required ModModel Mod { get; set; }
}
