<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="using:LauncherKit.Desktop.Services"
             x:Class="SampleLauncher.App.App"
             RequestedThemeVariant="Light">
	<Application.Styles>
		<FluentTheme />
	</Application.Styles>
	<Application.DataTemplates>
		<!-- The kit's INotificationService toasts; the window's notification manager lives in its adorner layer. -->
		<DataTemplate DataType="services:AppNotification">
			<StackPanel Spacing="4" MaxWidth="320">
				<TextBlock Name="NotificationTitle" Text="{Binding Title}" FontWeight="SemiBold" />
				<TextBlock Name="NotificationMessage" Text="{Binding Message}" TextWrapping="Wrap"
				           IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
				<ProgressBar IsIndeterminate="True" IsVisible="{Binding IsInProgress}" />
			</StackPanel>
		</DataTemplate>
	</Application.DataTemplates>
</Application>
