<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LauncherKit.Desktop.ViewModels"
             xmlns:conv="using:LauncherKit.Desktop.Converters"
             x:Class="SampleLauncher.App.Views.AppTaskQueueView"
             x:DataType="vm:AppTaskQueueViewModel">
	<StackPanel Spacing="12">
		<TextBlock Text="Tasks" FontSize="20" FontWeight="SemiBold" />
		<Button Name="ResumeButton" Content="Resume" Command="{Binding ResumeCommand}" />
		<ItemsControl Name="TaskList" ItemsSource="{Binding AppTasks}">
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="vm:AppTaskViewModel">
					<StackPanel Spacing="2" Margin="0 0 0 8">
						<TextBlock Text="{Binding AppTask.Description, Converter={x:Static conv:TaskDescriptionConverter.Instance}}" FontWeight="SemiBold" />
						<TextBlock Text="{Binding RunningMicroTaskDescription, Converter={x:Static conv:TaskDescriptionConverter.Instance}}" />
						<TextBlock Foreground="Firebrick" TextWrapping="Wrap"
						           Text="{Binding Error, Converter={x:Static conv:ExceptionDisplayConverter.Instance}}"
						           IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
					</StackPanel>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</StackPanel>
</UserControl>
