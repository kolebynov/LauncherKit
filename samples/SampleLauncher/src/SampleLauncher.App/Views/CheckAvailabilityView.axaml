<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LauncherKit.Desktop.ViewModels"
             x:Class="SampleLauncher.App.Views.CheckAvailabilityView"
             x:DataType="vm:CheckAvailabilityViewModel">
	<StackPanel Spacing="8">
		<TextBlock Name="AvailabilityStatus" Text="{Binding CheckStatus}" />
		<StackPanel Orientation="Horizontal" Spacing="8">
			<Button Name="RetryButton" Content="Retry" Command="{Binding CheckAvailabilityCommand}" IsVisible="{Binding IsUnavailable}" />
			<Button Name="ContinueOfflineButton" Content="Continue without downloads" Command="{Binding FinishCommand}"
			        IsVisible="{Binding IsUnavailable}" />
			<Button Name="ContinueButton" Content="Continue" Command="{Binding FinishCommand}" IsVisible="{Binding !IsUnavailable}" />
		</StackPanel>
	</StackPanel>
</UserControl>
