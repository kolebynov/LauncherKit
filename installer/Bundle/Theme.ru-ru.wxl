<?xml version="1.0" encoding="utf-8"?>
<!--
Russian strings of WixStdBA's hyperlinkLicense theme (every ID of WiX 7.0.1's HyperlinkTheme.wxl), used whatever the
user's Windows language is, plus the strings of the controls Theme.xml adds.
-->
<WixLocalization Culture="ru-ru" Language="1049" xmlns="http://wixtoolset.org/schemas/v4/wxl">
	<String Id="Caption" Value="Установка [WixBundleName]" />
	<String Id="Title" Value="[WixBundleName]" />
	<String Id="CheckingForUpdatesLabel" Value="Проверка обновлений" />
	<String Id="UpdateButton" Value="&amp;Обновить до версии [WixStdBAUpdateAvailable]" />
	<String Id="InstallHeader" Value="Добро пожаловать" />
	<String Id="InstallMessage" Value="Программа установит [WixBundleName] на компьютер. Нажмите «Установить», чтобы продолжить, или «Отмена», чтобы выйти." />
	<String Id="InstallMessageOptions" Value="Программа установит [WixBundleName] на компьютер. Нажмите «Установить», чтобы продолжить, «Параметры», чтобы изменить параметры установки, или «Отмена», чтобы выйти." />
	<String Id="InstallVersion" Value="Версия [WixBundleVersion]" />
	<String Id="ConfirmCancelMessage" Value="Отменить установку?" />
	<String Id="ExecuteUpgradeRelatedBundleMessage" Value="Предыдущая версия" />
	<String Id="HelpHeader" Value="Справка по установке" />
	<String Id="HelpText" Value="/install | /repair | /uninstall | /layout [папка] - установка, восстановление, удаление или&#xA;   создание полной локальной копии установщика в папке. По умолчанию - установка.&#xA;&#xA;/passive | /quiet - минимальный интерфейс без вопросов или работа без интерфейса и&#xA;   без вопросов. По умолчанию показываются интерфейс и все вопросы.&#xA;&#xA;/norestart   - не перезагружать компьютер. По умолчанию перед перезагрузкой задается вопрос.&#xA;/log log.txt - журнал в указанный файл. По умолчанию журнал создается в %TEMP%." />
	<String Id="HelpCloseButton" Value="&amp;Закрыть" />
	<String Id="InstallLicenseLinkText" Value="&lt;a href=&quot;#&quot;&gt;Лицензионное соглашение&lt;/a&gt; [WixBundleName]." />
	<String Id="InstallAcceptCheckbox" Value="Я &amp;принимаю условия лицензионного соглашения" />
	<String Id="InstallDesktopShortcutCheckbox" Value="Создать ярлык на &amp;рабочем столе" />
	<String Id="InstallStartMenuShortcutCheckbox" Value="Добавить в меню «&amp;Пуск» (поиск Windows)" />
	<String Id="InstallOptionsButton" Value="&amp;Параметры" />
	<String Id="InstallInstallButton" Value="&amp;Установить" />
	<String Id="InstallCancelButton" Value="&amp;Отмена" />
	<String Id="OptionsHeader" Value="Параметры установки" />
	<String Id="OptionsLocationLabel" Value="Папка установки:" />
	<String Id="OptionsPerUserScopeText" Value="Установить [WixBundleName] только для &amp;меня" />
	<String Id="OptionsPerMachineScopeText" Value="Установить [WixBundleName] для &amp;всех пользователей" />
	<String Id="OptionsBrowseButton" Value="&amp;Обзор" />
