<Project>
	<!--
	Shared by the launcher package (LauncherKit.Installer.props) and the setup bundle: checks the consumer's product
	properties both need and passes them to the WiX preprocessor as $(var.<Name>). The package is per-user, so the
	product registry key must be under HKEY_CURRENT_USER; WiX gets its path as LauncherRegistryKeyPath.
	-->
	<PropertyGroup>
		<!-- Accepts the WiX 7 Open Source Maintenance Fee EULA. -->
		<AcceptEula>wix7</AcceptEula>
	</PropertyGroup>

	<Target Name="LauncherKitInstallerSharedConstants" BeforeTargets="_CreateProjectDefineConstants">
		<Error Condition="!$(LauncherRegistryKey.StartsWith('HKEY_CURRENT_USER\'))"
		       Text="LauncherRegistryKey must be a key under HKEY_CURRENT_USER for the per-user installer, not '$(LauncherRegistryKey)'."/>
		<ItemGroup>
			<_LauncherInstallerConstant Include="LauncherDisplayName" Value="$(LauncherDisplayName)"/>
			<_LauncherInstallerConstant Include="LauncherManufacturer" Value="$(LauncherManufacturer)"/>
			<_LauncherInstallerConstant Include="LauncherRegistryKeyPath" Value="$(LauncherRegistryKey.Substring(18))"/>
			<_LauncherInstallerConstant Include="LauncherIconFile" Value="$(LauncherIconFile)"/>
			<_LauncherInstallerConstant Include="@(LauncherInstallerConstant)"/>
			<!--
			Optional: LauncherInstallerDefaultFolder (a Burn/MSI formatted path such as
			[LocalAppDataFolder]Programs\MyLauncher) lets the user choose the launchers root on the setup's Options page,
			starting from that folder. Without it the root is the layout's fixed LAUNCHERSROOT.
			-->
			<_LauncherInstallerConstant Include="LauncherInstallerFolderChoice" Value="no" Condition="'$(LauncherInstallerDefaultFolder)' == ''"/>
			<_LauncherInstallerConstant Include="LauncherInstallerFolderChoice" Value="yes" Condition="'$(LauncherInstallerDefaultFolder)' != ''"/>
			<_LauncherInstallerConstant Include="LauncherInstallerDefaultFolder" Value="$(LauncherInstallerDefaultFolder)" Condition="'$(LauncherInstallerDefaultFolder)' != ''"/>
		</ItemGroup>
		<Error Condition="'%(_LauncherInstallerConstant.Value)' == ''"
		       Text="LauncherKit installer property '%(_LauncherInstallerConstant.Identity)' is required."/>
		<Error Condition="$([System.String]::Copy('%(_LauncherInstallerConstant.Value)').Contains(';'))"
		       Text="LauncherKit installer property '%(_LauncherInstallerConstant.Identity)' must not contain ';'."/>
		<PropertyGroup>
			<DefineConstants>$(DefineConstants);@(_LauncherInstallerConstant->'%(Identity)=%(Value)')</DefineConstants>
		</PropertyGroup>
	</Target>
</Project>
